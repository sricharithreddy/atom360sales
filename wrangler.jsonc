// Cloudflare deploy: a static site, no server code. `npm run build` writes dist/,
// and `npx wrangler deploy` uploads it as the Worker's static assets.
{
  "name": "atom360sales",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
